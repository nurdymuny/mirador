\@writefile{toc}{\contentsline {section}{\numberline {1}The Clinical Gap}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Governing Equation}{1}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}The Four Curvature Layers}{2}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Layer 1: Pediatric Patient Manifold}{2}{subsection.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Layer 2: Bone Penetration Curvature}{2}{subsection.3.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Bone penetration ratios and resulting curvature contributions. $K_{\text  {penetration}} = (1/R_{\text  {bone}}) - 1$.}}{3}{table.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Layer 3: Biofilm Resistance Curvature}{3}{subsection.3.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces MIC, MBEC, and biofilm curvature by drug. Rifampin has the lowest $K_{\text  {biofilm}}$ of any anti-staphylococcal agent — the geometric basis for combination therapy in chronic AHO.}}{3}{table.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Layer 4: Multi-Reservoir Geometry}{4}{subsection.3.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Three-reservoir model. Small colony variants (SCVs) inside osteocytes are the primary driver of relapse in chronic AHO. They are not reached by surgical intervention and are accessible only to drugs with intracellular penetration — principally rifampin and linezolid.}}{4}{table.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Applied to a Validated Clinical Case}{4}{section.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Cure threshold: $C_{\text  {bone}} \geq 5.0$. No monotherapy achieves it in 6-year chronic MRSA-AHO with confirmed biofilm. This result matches the documented clinical course for this patient and for the broader chronic AHO literature.}}{5}{table.4}\protected@file@percent }
