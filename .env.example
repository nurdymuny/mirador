# MIRADOR v1.0 — Environment Variables
# Copy this file to .env and fill in values

# ── LLM Fallback (Tier 4) ──────────────────────────────────────────
# Used when regex NL parser returns clarification_needed
# Only one provider is required; Claude is primary, Gemini is fallback

# Anthropic (Claude) — primary LLM fallback
ANTHROPIC_API_KEY=

# Google (Gemini) — secondary LLM fallback
GEMINI_API_KEY=

# ── Optional ────────────────────────────────────────────────────────
# GIGI engine server (defaults to https://gigi-stream.fly.dev)
# GIGI_SERVER_URL=https://gigi-stream.fly.dev
